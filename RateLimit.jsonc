{
  "name": "RateLimit",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "default": 0
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "_backend_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "_backend_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "_backend_only"
      }
    }
  }
}